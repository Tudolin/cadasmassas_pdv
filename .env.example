# =====================================================================
# CONFIGURACAO DO PDV - Casa das Massas Pinheirinho
#
# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O ".env" NUNCA vai para o Git (esta no .gitignore).
#
#   copy .env.example .env
#
# Tudo aqui e OPCIONAL: sem nenhuma variavel o PDV sobe, usa o catalogo
# do cache local e guarda as vendas apenas no SQLite. O Upstash e o que
# liga o PDV ao precifier.
# =====================================================================


# ---------------------------------------------------------------------
# 1) UPSTASH REDIS  (catalogo de precos + envio das vendas)
# ---------------------------------------------------------------------
# Onde achar: painel do Upstash -> seu banco -> aba "REST API".
# Sao os MESMOS valores que o precifier usa na Vercel, entao da para
# copiar de la (Vercel -> Settings -> Environment Variables).
#
# ATENCAO: use o token NORMAL, nao o "Read-Only Token". O PDV precisa
# gravar em `venda:*`. Confira rodando:
#     .venv\Scripts\python scripts\testar_redis.py

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# O PDV tambem aceita os nomes antigos do Vercel KV, se voce preferir:
#   KV_REST_API_URL= / KV_REST_API_TOKEN=
#   REDIS_REST_API_URL= / REDIS_REST_API_TOKEN=


# ---------------------------------------------------------------------
# 2) SERVIDOR LOCAL
# ---------------------------------------------------------------------
# Fica so no 127.0.0.1: o caixa nao precisa ser visivel na rede da loja.
# Mude o host apenas se souber exatamente por que.

PDV_HOST=127.0.0.1
PDV_PORTA=8777

# Threads do waitress. 4 e de sobra para um operador; subir isso gasta
# memoria no notebook sem ganhar nada.
PDV_THREADS=4


# ---------------------------------------------------------------------
# 3) LEITURA DA ETIQUETA DA BALANCA
# ---------------------------------------------------------------------
# Quantos digitos o campo de preco ocupa na etiqueta de 13 digitos.
#
#   5 = posicoes 8-12, ate R$ 999,99  <- PADRAO, e o que a loja usa hoje
#   4 = posicoes 9-12, ate R$  99,99  <- a especificacao escrita
#
# As duas leituras dao o MESMO valor nas etiquetas atuais. A diferenca
# aparece so acima de R$ 99,99, e ai o modo 4 erra R$ 100 para baixo.
# Leia o cabecalho de pdv/codigo_barras.py antes de mexer.

PDV_DIGITOS_PRECO=5


# ---------------------------------------------------------------------
# 4) IMPRESSORA TERMICA
# ---------------------------------------------------------------------
# Vazio = usa a impressora padrao do Windows.
# Para ver os nomes disponiveis, com o PDV aberto:
#     http://127.0.0.1:8777/api/impressoras

PDV_IMPRESSORA=

# Largura da bobina em caracteres: 48 = 80 mm (o normal), 32 = 58 mm.
PDV_LARGURA_CUPOM=48

# Pagina de codigo da impressora. cp860 = portugues (acentos corretos).
# Se sair caractere estranho no lugar de "CAO"/"DEBITO", tente cp850.
PDV_CODEPAGE_CUPOM=cp860

# 0 para nao imprimir (util em teste). O cupom continua sendo salvo em
# dados\cupons\ de qualquer forma.
PDV_IMPRIMIR=1


# ---------------------------------------------------------------------
# 5) SINCRONIZACAO
# ---------------------------------------------------------------------
# De quantos em quantos segundos comparar `catalogo:versao`.
PDV_INTERVALO_CATALOGO=60

# De quantos em quantos segundos tentar esvaziar a fila de vendas.
# (Uma venda nova acorda a fila na hora; isto e so a rede de seguranca.)
PDV_INTERVALO_FILA=15

# Timeout de cada chamada ao Upstash, em segundos.
PDV_TIMEOUT_REDE=8

# 0 = tenta reenviar para sempre, com backoff. Recomendado: uma venda
# nunca deve ser desistida em silencio.
PDV_MAX_TENTATIVAS_VENDA=0


# ---------------------------------------------------------------------
# 6) NOTA FISCAL  (opcional, desligada)
# ---------------------------------------------------------------------
# LEIA pdv/nota_fiscal.py ANTES DE LIGAR. Resumo: o emissor herdado do
# repo pdv-python e um script Selenium que dirige o site da IOB, exige
# captcha resolvido por pessoa e nunca conclui a nota sozinho.
#
#   PDV_NF_TIPO=arquivo  -> registra o pedido em dados\notas\*.json
#                           (nao transmite nada; e o padrao honesto)
#   PDV_NF_TIPO=iob      -> Selenium + Chrome (nao conclui; veja o modulo)

PDV_NF_HABILITADA=0
PDV_NF_TIPO=arquivo
PDV_NF_USUARIO=
PDV_NF_SENHA=
